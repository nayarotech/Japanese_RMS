# =============================================================================
# restaurant-platform: environment template (LOCAL DEVELOPMENT ONLY)
#
# Copy to `.env` for local Docker Compose development. `.env` is gitignored.
# Values here are placeholders. NEVER put real credentials in this file or in Git.
# Staging/production values come from the secret manager of the hosting
# platform (see docs/architecture/09-deployment-strategy.md).
#
# The runtime schema that validates these variables will live in
# packages/config (not implemented in Phase 0).
# =============================================================================

# --- Deployment ---------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
NODE_ENV=development
# Logical instance name for logs/metrics only. Never used in business logic.
INSTANCE_NAME=local-1

# --- Logging ------------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# true = human-readable logs locally. Must be false in staging/production (JSON logs).
LOG_PRETTY=true

# --- HTTP / origins -----------------------------------------------------------
API_PORT=4000
WEB_PORT=3000
WORKER_HEALTH_PORT=4100
# Public origin(s) the browser uses. Comma-separated. Used for CORS/Origin/CSRF checks.
# Brand custom domains are resolved from the database, not listed here.
APP_PUBLIC_ORIGINS=http://localhost:3000
# Number of trusted reverse-proxy hops in front of the API (for client IP resolution).
TRUST_PROXY_HOPS=1

# --- PostgreSQL ---------------------------------------------------------------
# Two separate credentials by design (docs/architecture/07-database-principles.md):
#  * MIGRATOR: owns the schema, runs migrations only. Never used by running apps.
#  * APP: runtime role. No DDL, no BYPASSRLS, not the table owner.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=restaurant_platform
# Superuser for the local container only (used by the init script to create roles).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-dev-only-change-me
DATABASE_MIGRATOR_USER=rp_migrator
DATABASE_MIGRATOR_PASSWORD=local-dev-only-change-me
DATABASE_APP_USER=rp_app
DATABASE_APP_PASSWORD=local-dev-only-change-me
# Worker outbox relay: read/mark outbox rows only (cross-tenant), nothing else.
DATABASE_RELAY_USER=rp_relay
DATABASE_RELAY_PASSWORD=local-dev-only-change-me
# Bounded pool per process. Total = replicas x pool size; must fit DB limits.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_IDLE_IN_TX_TIMEOUT_MS=10000
# disable (local only) | require | verify-full (staging/production)
DATABASE_SSL_MODE=disable

# --- Redis --------------------------------------------------------------------
# Used for Socket.IO cross-instance broadcast, rate limiting and selected caches.
# NEVER the source of truth for orders, payments or entitlements.
# Host port for the local Redis container (change if 6379 is taken by another project).
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=local-dev-only-change-me
REDIS_TLS=false

# --- Sessions / security --------------------------------------------------------
# Generate locally with: openssl rand -base64 48  (minimum 32 characters)
SESSION_SECRET=replace-with-generated-local-secret-of-at-least-32-chars
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# Cookie `Secure` flag. Must be true everywhere except plain-HTTP localhost.
COOKIE_SECURE=false

# --- WebSocket ----------------------------------------------------------------
SOCKET_IO_PATH=/socket.io
# Max time to drain connections on shutdown before forcing close.
SHUTDOWN_GRACE_PERIOD_MS=25000

# --- Object storage (S3-compatible) -------------------------------------------
# Menu item photos (and later brand assets, exports). Binaries never go to PostgreSQL.
# s3    = any S3-compatible service (REQUIRED in staging/production)
# local = files under STORAGE_LOCAL_DIR on this machine (single-host local development only)
# memory = tests only
STORAGE_DRIVER=local
# Relative to the API working directory (apps/api). Gitignored.
STORAGE_LOCAL_DIR=.data/storage
# S3 settings (used when STORAGE_DRIVER=s3). Leave ENDPOINT empty for AWS; set it for other S3-compatible services.
STORAGE_ENDPOINT=
STORAGE_REGION=ap-northeast-1
STORAGE_BUCKET=
# Optional static keys. Prefer the platform's role-based credentials (leave both empty) in deployed environments.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# true for S3-compatible services that need path-style URLs (most self-hosted ones).
STORAGE_FORCE_PATH_STYLE=false
# Public delivery base URL (CDN or public-read bucket), https in staging/production, no trailing slash.
# Empty = photos are served by the API at /api/v1/public/media/* (active photos only).
STORAGE_PUBLIC_BASE_URL=
# Maximum upload size for a menu photo, in bytes (default 5 MB). Keep the proxy limit in infra/proxy/nginx.conf above it.
MENU_IMAGE_MAX_BYTES=5242880

# --- Online ordering: delivery address geocoding -----------------------------------
# disabled    = delivery orders are refused until a real provider is integrated (pickup still works)
# static_demo = built-in demo postal codes around the demo store (LOCAL DEVELOPMENT AND TESTS ONLY)
GEOCODER_PROVIDER=static_demo
GEOCODER_TIMEOUT_MS=3000

# --- Localization defaults ------------------------------------------------------
DEFAULT_LOCALE=ja
DEFAULT_TIME_ZONE=Asia/Tokyo
DEFAULT_CURRENCY=JPY

# --- Frontend (exposed to the browser: never put secrets in NEXT_PUBLIC_*) --------
# Server-side URL the Next.js server uses to reach the API inside the private network.
WEB_INTERNAL_API_URL=http://localhost:4000
# Socket.IO origin for the browser. Empty = same origin (production behind the load balancer).
# Local dev: the API port, because the Next.js dev server does not proxy WebSocket upgrades.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

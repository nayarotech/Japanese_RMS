# Dependencies
node_modules/

# Build output
dist/
.next/
out/
*.tsbuildinfo

# Local development object storage (STORAGE_DRIVER=local)
.data/

# Test output
coverage/
playwright-report/
test-results/

# Environment files: never commit real values. Only *.example files are tracked.
.env
.env.*
!.env.example
!**/*.env.example

# Secrets and keys
*.pem
*.key
*.p12
secrets/

# Logs and OS / editor files
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
